# Copy this file to `.env` and adjust the path below.
#
# VS Code's Python/Jupyter extension automatically loads `.env` into the kernel
# environment at startup, so notebooks (e.g. notebooks/full_workflow.ipynb) can
# find your software configuration without hard-coding a path.
#
# `.env` is git-ignored; `.env.example` is tracked as a template.
# Restart the Jupyter kernel after changing `.env`.

QM_ATLAS_SOFTWARE_CONFIG_FILE=/path/to/your/software_config.yaml
